# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# From console.anthropic.com → API Keys.
# Only used as a fallback for the user IDs listed in OWNER_USER_IDS —
# every other user must supply their own key in Settings.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Comma-separated Supabase auth user IDs allowed to fall back to the keys above.
OWNER_USER_IDS=

# From apify.com → Settings → Integrations → API token
APIFY_API_KEY=apify_api_your-apify-api-key
